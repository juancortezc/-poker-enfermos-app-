{
  "expo": {
    "name": "Poker Enfermos",
    "slug": "poker-enfermos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/favicon-512.png",
    "scheme": "pokerenfermos",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1F1410",
    "ios": {
      "bundleIdentifier": "com.pokerenfermos.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para desbloquear tu clave de Poker Enfermos sin tener que escribirla.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pokerenfermos.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F1410",
        "foregroundImage": "./assets/icons/favicon-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icons/favicon-64.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F1410",
          "image": "./assets/icons/favicon-512.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para desbloquear tu clave de Poker Enfermos sin tener que escribirla."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/timer_minuto.wav", "./assets/sounds/timer_cambio.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b72c7d91-0b54-4501-8e06-0c72fddc6664"
      }
    },
    "owner": "101grados"
  }
}
