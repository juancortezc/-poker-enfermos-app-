{
  "expo": {
    "name": "Poker Enfermos",
    "slug": "poker-enfermos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "scheme": "pokerenfermos",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.pokerenfermos.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para desbloquear tu clave de Poker Enfermos sin tener que escribirla.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pokerenfermos.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/app/adaptive-foreground.png",
        "monochromeImage": "./assets/app/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icons/favicon-64.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/app/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/app/splash-logo.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para desbloquear tu clave de Poker Enfermos sin tener que escribirla."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#E53935",
          "defaultChannel": "default",
          "sounds": ["./assets/sounds/timer_minuto.wav", "./assets/sounds/timer_cambio.wav"]
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos solo para adjuntar una imagen a tus propuestas.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b72c7d91-0b54-4501-8e06-0c72fddc6664"
      }
    },
    "owner": "101grados"
  }
}
