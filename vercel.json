{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "regions": ["iad1"],
  "env": {
    "SKIP_ENV_VALIDATION": "1"
  },
  "crons": [
    {
      "path": "/api/cron/birthdays",
      "schedule": "0 12 * * *"
    }
  ]
}